# Salin file ini menjadi .env lalu sesuaikan
# PostgreSQL dijalankan NATIVE di server/komputer (bukan Docker)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://bengkel_user:bengkel_pass@localhost:5432/bengkel_db?schema=public"

PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET="ganti_dengan_secret_acak_yang_kuat"
JWT_REFRESH_SECRET="ganti_dengan_secret_lain_yang_kuat"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Tax default (%) - bisa juga diatur lewat menu Admin > Pengaturan Aplikasi
DEFAULT_TAX_SERVICE=10
DEFAULT_TAX_SALES=10

# URL frontend untuk CORS
CLIENT_URL="http://localhost:5173"

# Upload
UPLOAD_DIR="uploads"
